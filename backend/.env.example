# Copy to .env and fill in. On cPanel: chmod 600 .env
SECRET_KEY=change-me
DEBUG=false
ALLOWED_HOSTS=api.ainolez.com

# Leave DB_ENGINE unset on servers with MySQL 8 / MariaDB 10.5+.
# Set DB_ENGINE=config.db.mariadb104 only for XAMPP's MariaDB 10.4.
DB_NAME=cpaneluser_ainolez
DB_USER=cpaneluser_app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

FRONTEND_URL=https://ainolez.com
CORS_ALLOWED_ORIGINS=https://ainolez.com

# cPanel mailbox
EMAIL_HOST=mail.ainolez.com
EMAIL_PORT=465
EMAIL_HOST_USER=no-reply@ainolez.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=ainolez <no-reply@ainolez.com>

# Media library (web-served folder)
MEDIA_ROOT=/home/cpaneluser/api.ainolez.com/media
MEDIA_URL=https://api.ainolez.com/media/

# SEO: the website folder that gets prerendered pages, sitemap.xml, robots.txt
PRERENDER_DIR=/home/cpaneluser/public_html

# Rate-limit counters (shared by all app processes). Default: backend/tmp/cache
# CACHE_DIR=/home/cpaneluser/ainolez-cache

# AI tutor (Claude API)
ANTHROPIC_API_KEY=
# Points a member needs before posting without moderator approval
COMMUNITY_TRUSTED_POINTS=100
